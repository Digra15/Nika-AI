# NIKA — Autonomous AI VTuber Configuration
# 9Router OpenAI-compatible AI Gateway (NEVER use Gemini directly as runtime brain)
NIKA_AI_BASE_URL=http://127.0.0.1:20128/v1
NIKA_AI_API_KEY=9router-local-key
NIKA_AI_MODEL=auto
NIKA_AI_TEMPERATURE=0.7
NIKA_AI_MAX_TOKENS=1024
NIKA_AI_REASONING_EFFORT=medium

# Local Voice Engine Sidecar (100% Local - No Cloud STT/TTS)
NIKA_VOICE_HOST=127.0.0.1
NIKA_VOICE_PORT=20135

# Local STT (faster-whisper)
NIKA_STT_ENGINE=faster-whisper
NIKA_STT_MODEL=small
NIKA_STT_DEVICE=cpu
NIKA_STT_COMPUTE_TYPE=int8
NIKA_STT_LANGUAGE=auto

# Local TTS (piper | kokoro | auto)
NIKA_TTS_ENGINE=auto
NIKA_TTS_VOICE_ID=id_ID-news_tts-medium
NIKA_TTS_VOICE_EN=af_heart
NIKA_TTS_SPEED=1.0

# Voice Activity Detection (Silero VAD)
NIKA_VAD_THRESHOLD=0.5
NIKA_VAD_MIN_SILENCE_MS=550
NIKA_VAD_WAKE_WORD=nika

# UI & Window
NIKA_ALWAYS_ON_TOP=false
NIKA_LANGUAGE=id
